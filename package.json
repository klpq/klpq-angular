{
  "name": "klpq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prettier": "prettier \"**/*\" --list-different --ignore-unknown",
    "prettier:fix": "prettier \"**/*\" --write --ignore-unknown",
    "env": "node env.js",
    "ng": "vite",
    "start": "yarn run env && vite --host 0.0.0.0 --port 4200",
    "build": "yarn run env && tsc --noEmit && vite build",
    "build:azure": "yarn run env && ./node_modules/.bin/vite build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-push": "yarn run prettier"
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-query": "^5.108.4",
    "clsx": "^2.1.1",
    "dashjs": "^5.3.0",
    "dotenv": "^18.0.10",
    "hls.js": "^1.7.4",
    "humanize-duration": "^3.35.1",
    "lucide-react": "^1.78.0",
    "mpegts.js": "^1.8.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/humanize-duration": "^3.27.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
